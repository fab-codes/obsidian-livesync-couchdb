# Copy to .env for local testing with `docker compose up`.
# On Railway these values go in the service Variables, NOT here.

# CouchDB admin user.
COUCHDB_USER=obsidian

# Password: generate a long random one, for example with
#   openssl rand -base64 36
COUCHDB_PASSWORD=changeme

# Secret used to sign session cookies. If unset, CouchDB generates a new one
# on every deploy. Generate with:
#   openssl rand -hex 32
COUCHDB_SECRET=changeme

# HTTP port, for this local setup only. On Railway do not set PORT: the
# platform injects it (8080) and entrypoint.sh makes CouchDB listen on that.
PORT=5984
